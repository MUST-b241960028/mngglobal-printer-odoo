<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="mng_topic_hub_action" model="ir.actions.client">
        <field name="name">Мэдээллийн сан</field>
        <field name="tag">mngglobal_hub.topic_hub</field>
    </record>

    <record id="mng_topic_category_list_view" model="ir.ui.view">
        <field name="name">mng.topic.category.list</field>
        <field name="model">mng.topic.category</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="accent"/>
                <field name="topic_count"/>
            </list>
        </field>
    </record>

    <record id="mng_topic_category_action" model="ir.actions.act_window">
        <field name="name">Ангилал</field>
        <field name="res_model">mng.topic.category</field>
        <field name="view_mode">list</field>
    </record>

    <record id="mng_topic_archived_list_view" model="ir.ui.view">
        <field name="name">mng.topic.archived.list</field>
        <field name="model">mng.topic</field>
        <field name="arch" type="xml">
            <list create="0">
                <field name="name"/>
                <field name="category_id"/>
                <field name="owner_id"/>
                <field name="last_editor_id"/>
                <field name="last_edited_at"/>
                <field name="active" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="mng_topic_archived_action" model="ir.actions.act_window">
        <field name="name">Архивласан сэдэв</field>
        <field name="res_model">mng.topic</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="mng_topic_archived_list_view"/>
        <field name="domain">[('active', '=', False)]</field>
        <field name="context">{'active_test': False}</field>
    </record>

    <record id="mng_topic_page_archived_list_view" model="ir.ui.view">
        <field name="name">mng.topic.page.archived.list</field>
        <field name="model">mng.topic.page</field>
        <field name="arch" type="xml">
            <list create="0">
                <field name="topic_id"/>
                <field name="name"/>
                <field name="last_editor_id"/>
                <field name="last_edited_at"/>
                <field name="active" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="mng_topic_page_archived_action" model="ir.actions.act_window">
        <field name="name">Архивласан хуудас</field>
        <field name="res_model">mng.topic.page</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="mng_topic_page_archived_list_view"/>
        <field name="domain">[('active', '=', False)]</field>
        <field name="context">{'active_test': False}</field>
    </record>

</odoo>
