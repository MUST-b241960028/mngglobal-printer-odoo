<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="mng_print_wizard_view_form" model="ir.ui.view">
        <field name="name">mng.print.wizard.form</field>
        <field name="model">mng.print.wizard</field>
        <field name="arch" type="xml">
            <form string="🖨️ Оффист Хэвлэх — Урьдчилан Харах &amp; Тохиргоо">
                <div class="row" style="margin: 0;">
                    <!-- Left Side: Interactive Live PDF Preview -->
                    <div class="col-lg-7 col-md-7" style="padding-right: 15px; border-right: 1px solid #e0e0e0;">
                        <h4 class="text-primary mb-3">📄 Баримт Урьдчилан Харах</h4>
                        <field name="pdf_preview_html" widget="html" style="width: 100%;"/>
                    </div>

                    <!-- Right Side: Print Settings Panel -->
                    <div class="col-lg-5 col-md-5" style="padding-left: 15px;">
                        <h4 class="text-primary mb-3">⚙️ Хэвлэх Тохиргоо</h4>
                        
                        <group string="Принтер Сонголт">
                            <field name="printer_id" options="{'no_create': True, 'no_open': True}" placeholder="Суурь принтер хэрэглэх"/>
                            <field name="copies"/>
                        </group>

                        <group string="Хуудасны Сонголт">
                            <field name="pages" placeholder="ж: 1-3,5,8"/>
                            <field name="page_subset"/>
                        </group>

                        <group string="Хэвлэх Загвар">
                            <field name="orientation"/>
                            <field name="duplex"/>
                            <field name="color_mode"/>
                            <field name="scaling"/>
                        </group>

                        <field name="res_model" invisible="1"/>
                        <field name="res_id" invisible="1"/>
                    </div>
                </div>
                <footer>
                    <button name="action_print" string="🖨️ ХЭВЛЭХ" type="object" class="btn-success btn-lg font-weight-bold" style="padding: 10px 30px; font-size: 16px;"/>
                    <button string="Цуцлах" class="btn-secondary btn-lg" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="mng_print_wizard_action" model="ir.actions.act_window">
        <field name="name">🖨️ Хэвлэх Тохиргоо ба Урьдчилан Харах</field>
        <field name="res_model">mng.print.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
