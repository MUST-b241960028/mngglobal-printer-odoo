<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ══ Lead Kanban ══ -->
    <record id="mng_visa_lead_kanban" model="ir.ui.view">
        <field name="name">mng.visa.lead.kanban</field>
        <field name="model">mng.visa.lead</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" class="o_kanban_small_column"
                    on_create="quick_create">
                <field name="name"/>
                <field name="phone"/>
                <field name="interest"/>
                <field name="assigned_to"/>
                <field name="state"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_details">
                            <strong>
                                <field name="name"/>
                            </strong>
                            <div>📞 <field name="phone"/></div>
                            <div><field name="interest"/></div>
                            <div class="o_kanban_bottom_left">
                                <field name="assigned_to" widget="many2one_avatar_user"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- ══ Lead List ══ -->
    <record id="mng_visa_lead_list" model="ir.ui.view">
        <field name="name">mng.visa.lead.list</field>
        <field name="model">mng.visa.lead</field>
        <field name="arch" type="xml">
            <list>
                <field name="create_date" string="Огноо"/>
                <field name="name"/>
                <field name="phone"/>
                <field name="source"/>
                <field name="interest"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'new'"
                       decoration-warning="state == 'contacted'"
                       decoration-success="state == 'converted'"
                       decoration-danger="state == 'lost'"/>
                <field name="assigned_to" widget="many2one_avatar_user"/>
            </list>
        </field>
    </record>

    <!-- ══ Lead Form ══ -->
    <record id="mng_visa_lead_form" model="ir.ui.view">
        <field name="name">mng.visa.lead.form</field>
        <field name="model">mng.visa.lead</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_convert_to_application"
                            string="✅ Зуучлал эхлүүлэх"
                            type="object" class="oe_highlight"
                            invisible="state == 'converted'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="new,contacted,meeting,converted"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Нэр"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="phone"/>
                            <field name="email"/>
                            <field name="source"/>
                        </group>
                        <group>
                            <field name="interest"/>
                            <field name="assigned_to"/>
                            <field name="application_id" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Тэмдэглэл">
                            <field name="notes"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ══ Lead Action ══ -->
    <record id="mng_visa_lead_action" model="ir.actions.act_window">
        <field name="name">📞 Leads</field>
        <field name="res_model">mng.visa.lead</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Lead байхгүй байна
            </p>
            <p>Chatbot эсвэл гараар шинэ lead нэмнэ үү.</p>
        </field>
    </record>

</odoo>
