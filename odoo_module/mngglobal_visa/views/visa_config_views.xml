<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ══ Checklist Template List ══ -->
    <record id="mng_visa_checklist_tmpl_list" model="ir.ui.view">
        <field name="name">mng.visa.checklist.template.list</field>
        <field name="model">mng.visa.checklist.template</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="program_type_id"/>
                <field name="stage_id" domain="[('program_type_id', '=', program_type_id)]"/>
                <field name="name"/>
            </list>
        </field>
    </record>

    <!-- ══ Checklist Template Search ══ -->
    <record id="mng_visa_checklist_tmpl_search" model="ir.ui.view">
        <field name="name">mng.visa.checklist.template.search</field>
        <field name="model">mng.visa.checklist.template</field>
        <field name="arch" type="xml">
            <search>
                <field name="program_type_id"/>
                <field name="stage_id"/>
                <field name="name"/>
                <filter string="Хөтөлбөр" name="group_program"
                        context="{'group_by': 'program_type_id'}"/>
                <filter string="Үе шат" name="group_stage"
                        context="{'group_by': 'stage_id'}"/>
            </search>
        </field>
    </record>

    <!-- ══ Checklist Template Action ══ -->
    <record id="mng_visa_checklist_tmpl_action" model="ir.actions.act_window">
        <field name="name">Шалгах хуудасны загвар</field>
        <field name="res_model">mng.visa.checklist.template</field>
        <field name="view_mode">list</field>
        <field name="search_view_id" ref="mng_visa_checklist_tmpl_search"/>
    </record>


    <!-- ══ Fee Template List ══ -->
    <record id="mng_visa_fee_tmpl_list" model="ir.ui.view">
        <field name="name">mng.visa.fee.template.list</field>
        <field name="model">mng.visa.fee.template</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="program_type_id"/>
                <field name="name"/>
                <field name="fee_type"/>
                <field name="percentage" invisible="fee_type != 'percentage'"/>
                <field name="fixed_amount" invisible="fee_type != 'fixed'"/>
                <field name="currency_id"/>
                <field name="payment_method"/>
            </list>
        </field>
    </record>

    <!-- ══ Fee Template Search ══ -->
    <record id="mng_visa_fee_tmpl_search" model="ir.ui.view">
        <field name="name">mng.visa.fee.template.search</field>
        <field name="model">mng.visa.fee.template</field>
        <field name="arch" type="xml">
            <search>
                <field name="program_type_id"/>
                <field name="name"/>
                <filter string="Хөтөлбөр" name="group_program"
                        context="{'group_by': 'program_type_id'}"/>
            </search>
        </field>
    </record>

    <!-- ══ Fee Template Action ══ -->
    <record id="mng_visa_fee_tmpl_action" model="ir.actions.act_window">
        <field name="name">Төлбөрийн загвар</field>
        <field name="res_model">mng.visa.fee.template</field>
        <field name="view_mode">list</field>
        <field name="search_view_id" ref="mng_visa_fee_tmpl_search"/>
    </record>

    <!-- ══ Finance: Application list with payment columns ══ -->
    <record id="mng_visa_app_list_finance" model="ir.ui.view">
        <field name="name">mng.visa.application.list.finance</field>
        <field name="model">mng.visa.application</field>
        <field name="arch" type="xml">
            <list decoration-muted="active == False">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="program_type_id"/>
                <field name="stage_id"/>
                <field name="departure_date"/>
                <field name="total_fee"/>
                <field name="remaining_fee"/>
                <field name="payment_status" widget="badge"
                       decoration-danger="payment_status == 'unpaid'"
                       decoration-warning="payment_status == 'partial'"
                       decoration-success="payment_status == 'paid'"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="assigned_to" widget="many2one_avatar_user"/>
            </list>
        </field>
    </record>

    <!-- ══ Finance Action ══ -->
    <record id="mng_visa_app_action_finance" model="ir.actions.act_window">
        <field name="name">Төлбөрийн тоймлол</field>
        <field name="res_model">mng.visa.application</field>
        <field name="view_mode">list,form</field>
        <field name="views" eval="[(ref('mng_visa_app_list_finance'), 'list'), (False, 'form')]"/>
        <field name="groups_id" eval="[(4, ref('mngglobal_visa.group_visa_finance')), (4, ref('mngglobal_visa.group_visa_manager'))]"/>
    </record>

</odoo>

