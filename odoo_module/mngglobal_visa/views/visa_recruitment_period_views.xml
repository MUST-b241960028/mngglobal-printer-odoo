<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Folder Kanban View -->
    <record id="mng_visa_recruitment_period_kanban" model="ir.ui.view">
        <field name="name">mng.visa.recruitment.period.kanban</field>
        <field name="model">mng.visa.recruitment.period</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile" default_order="date_start desc">
                <field name="name"/>
                <field name="code"/>
                <field name="date_start"/>
                <field name="date_end"/>
                <field name="state"/>
                <field name="color"/>
                <field name="application_count"/>
                <field name="pending_count"/>
                <field name="paid_count"/>
                <field name="program_type_id"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click p-3 shadow-sm rounded border" style="background: #ffffff; position: relative;">
                            <div class="d-flex align-items-center mb-2">
                                <div style="font-size: 38px; color: #714B67; margin-right: 12px; line-height: 1;">📂</div>
                                <div class="flex-grow-1">
                                    <h5 class="fw-bold mb-1 text-primary">
                                        <field name="name"/>
                                    </h5>
                                    <span t-if="record.code.raw_value" class="badge bg-light text-dark border">
                                        <field name="code"/>
                                    </span>
                                    <span t-if="record.program_type_id.raw_value" class="badge bg-purple text-white ms-1">
                                        <field name="program_type_id"/>
                                    </span>
                                </div>
                                <div>
                                    <field name="state" widget="badge"
                                           decoration-success="state == 'active'"
                                           decoration-warning="state == 'draft'"
                                           decoration-muted="state == 'closed'"
                                           decoration-danger="state == 'archived'"/>
                                </div>
                            </div>

                            <div t-if="record.date_start.raw_value or record.date_end.raw_value" class="text-muted small mb-3">
                                📅 <field name="date_start"/> ~ <field name="date_end"/>
                            </div>

                            <div class="row text-center bg-light rounded py-2 mx-0 mb-3 border">
                                <div class="col-6 border-end">
                                    <div class="fs-5 fw-bold text-dark"><field name="application_count"/></div>
                                    <div class="text-uppercase text-muted" style="font-size: 11px;">Нийт Хүсэлт</div>
                                </div>
                                <div class="col-6">
                                    <div class="fs-5 fw-bold text-success"><field name="paid_count"/></div>
                                    <div class="text-uppercase text-muted" style="font-size: 11px;">Бүрэн Төлсөн</div>
                                </div>
                            </div>

                            <div class="d-grid">
                                <button type="object" name="action_view_applications" class="btn btn-outline-primary btn-sm fw-bold">
                                    📁 Хавтас Рүү Орох (<t t-esc="record.application_count.raw_value"/>)
                                </button>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Folder List View -->
    <record id="mng_visa_recruitment_period_list" model="ir.ui.view">
        <field name="name">mng.visa.recruitment.period.list</field>
        <field name="model">mng.visa.recruitment.period</field>
        <field name="arch" type="xml">
            <list string="Элсэлтийн хавтаснууд">
                <field name="name"/>
                <field name="code"/>
                <field name="date_start"/>
                <field name="date_end"/>
                <field name="program_type_id"/>
                <field name="application_count" string="Аппликейшн тоо"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'active'"
                       decoration-warning="state == 'draft'"
                       decoration-muted="state == 'closed'"/>
            </list>
        </field>
    </record>

    <!-- Folder Form View -->
    <record id="mng_visa_recruitment_period_form" model="ir.ui.view">
        <field name="name">mng.visa.recruitment.period.form</field>
        <field name="model">mng.visa.recruitment.period</field>
        <field name="arch" type="xml">
            <form string="Элсэлтийн үе / Хавтас">
                <header>
                    <field name="state" widget="statusbar" statusbar_visible="draft,active,closed"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_applications"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-folder-open">
                            <field name="application_count" widget="statinfo" string="Аппликейшнууд"/>
                        </button>
                    </div>

                    <div class="oe_title">
                        <label for="name" string="Элсэлтийн нэр / Хавтасны нэр"/>
                        <h1>
                            <field name="name" placeholder="ж: 2026 Оны 9-р сарын элсэлт"/>
                        </h1>
                    </div>

                    <group>
                        <group string="Үндсэн мэдээлэл">
                            <field name="code" placeholder="ж: SEP-2026"/>
                            <field name="program_type_id"/>
                            <field name="color" widget="color_picker"/>
                        </group>
                        <group string="Хугацаа ба Хүлээн авалт">
                            <field name="date_start"/>
                            <field name="date_end"/>
                            <field name="active"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="📂 Хавтасны хүсэлтүүд" name="applications">
                            <field name="application_ids" readonly="1">
                                <list>
                                    <field name="name"/>
                                    <field name="client_name"/>
                                    <field name="client_phone"/>
                                    <field name="program_type_id"/>
                                    <field name="stage_id"/>
                                    <field name="payment_status" widget="badge"/>
                                    <field name="assigned_to" widget="many2one_avatar_user"/>
                                </list>
                            </field>
                        </page>
                        <page string="Тэмдэглэл" name="notes">
                            <field name="note" placeholder="Энэхүү элсэлтийн үеийн тусгай санамж, зааварчилгаа..."/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Folder Action -->
    <record id="mng_visa_recruitment_period_action" model="ir.actions.act_window">
        <field name="name">📁 Элсэлтийн хавтаснууд</field>
        <field name="res_model">mng.visa.recruitment.period</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Шинэ элсэлтийн хавтас үүсгэх!
            </p>
            <p>
                Оюутан элсүүлэлтийн хугацаа бүрийг тусгай хавтас болгон тохируулж, визийн хүсэлтүүдээ хавтас хавтасаар нь ангилан харна уу.
            </p>
        </field>
    </record>

</odoo>
