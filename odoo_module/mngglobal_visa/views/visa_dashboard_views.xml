<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="mng_visa_dashboard_form" model="ir.ui.view">
        <field name="name">mng.visa.dashboard.form</field>
        <field name="model">mng.visa.dashboard</field>
        <field name="arch" type="xml">
            <form string="Удирдлагын самбар" create="0" edit="0" delete="0">
                <field name="currency_id" invisible="1"/>
                <sheet style="background: transparent; border: none; max-width: 1400px; padding: 0;">
                    
                    <!-- Modern Title -->
                    <div class="d-flex justify-content-between align-items-center mb-4 pb-3 border-bottom">
                        <h2 class="fw-bold m-0" style="color: #0f172a;">
                            MNG Global <span class="text-primary">•</span> Удирдлагын самбар
                        </h2>
                    </div>

                    <!-- ROW 1: Key Metrics (Global Overview) -->
                    <div class="row g-4 mb-5">
                        <!-- Active Applications -->
                        <div class="col-md-3">
                            <button type="object" name="action_open_applications" 
                                    class="btn btn-light w-100 text-start border-0 shadow-sm rounded-4 p-4 d-flex align-items-center"
                                    style="background-color: white; transition: transform 0.2s;">
                                <div class="rounded-3 d-flex align-items-center justify-content-center" 
                                     style="width: 60px; height: 60px; background-color: #e0e7ff; color: #4f46e5;">
                                    <i class="fa fa-briefcase fa-2x"/>
                                </div>
                                <div class="ms-3 overflow-hidden">
                                    <div class="text-muted text-uppercase fw-bold" style="font-size: 11px; letter-spacing: 0.5px;">Идэвхтэй өргөдөл</div>
                                    <div class="fs-2 fw-bold text-dark mt-1" style="line-height: 1;"><field name="total_active" readonly="1"/></div>
                                </div>
                            </button>
                        </div>

                        <!-- Departures -->
                        <div class="col-md-3">
                            <button type="object" name="action_open_departures" 
                                    class="btn btn-light w-100 text-start border-0 shadow-sm rounded-4 p-4 d-flex align-items-center"
                                    style="background-color: white;">
                                <div class="rounded-3 d-flex align-items-center justify-content-center" 
                                     style="width: 60px; height: 60px; background-color: #d1fae5; color: #059669;">
                                    <i class="fa fa-plane fa-2x"/>
                                </div>
                                <div class="ms-3 overflow-hidden">
                                    <div class="text-muted text-uppercase fw-bold" style="font-size: 11px; letter-spacing: 0.5px;">Ойрын нисэлтүүд</div>
                                    <div class="fs-2 fw-bold text-dark mt-1" style="line-height: 1;"><field name="departures_next_30" readonly="1"/></div>
                                </div>
                            </button>
                        </div>

                        <!-- Overdue -->
                        <div class="col-md-3" groups="mngglobal_visa.group_visa_finance,mngglobal_visa.group_visa_manager">
                            <button type="object" name="action_open_overdue" 
                                    class="btn btn-light w-100 text-start border-0 shadow-sm rounded-4 p-4 d-flex align-items-center"
                                    style="background-color: white;">
                                <div class="rounded-3 d-flex align-items-center justify-content-center" 
                                     style="width: 60px; height: 60px; background-color: #ffe4e6; color: #e11d48;">
                                    <i class="fa fa-exclamation-triangle fa-2x"/>
                                </div>
                                <div class="ms-3 overflow-hidden">
                                    <div class="text-muted text-uppercase fw-bold" style="font-size: 11px; letter-spacing: 0.5px;">Төлбөр хэтэрсэн</div>
                                    <div class="fs-2 fw-bold text-dark mt-1" style="line-height: 1;"><field name="overdue_payments" readonly="1"/></div>
                                </div>
                            </button>
                        </div>

                        <!-- Insurance -->
                        <div class="col-md-3">
                            <button type="object" name="action_open_insurance" 
                                    class="btn btn-light w-100 text-start border-0 shadow-sm rounded-4 p-4 d-flex align-items-center"
                                    style="background-color: white;">
                                <div class="rounded-3 d-flex align-items-center justify-content-center" 
                                     style="width: 60px; height: 60px; background-color: #fef3c7; color: #d97706;">
                                    <i class="fa fa-shield fa-2x"/>
                                </div>
                                <div class="ms-3 overflow-hidden">
                                    <div class="text-muted text-uppercase fw-bold" style="font-size: 11px; letter-spacing: 0.5px;">Даатгал дуусах</div>
                                    <div class="fs-2 fw-bold text-dark mt-1" style="line-height: 1;"><field name="insurance_due_soon" readonly="1"/></div>
                                </div>
                            </button>
                        </div>
                    </div>

                    <!-- ROW 2: Program Distribution -->
                    <div class="card border-0 shadow-sm rounded-4 mb-5">
                        <div class="card-header bg-white border-bottom-0 pt-4 pb-0 px-4">
                            <h5 class="fw-bold m-0" style="color: #1e293b;">
                                <i class="fa fa-globe text-primary me-2"/> Хөтөлбөрийн хуваарилалт
                            </h5>
                        </div>
                        <div class="card-body p-4">
                            <div class="row g-3">
                                <div class="col">
                                    <button type="object" name="action_open_ph_adult" class="btn btn-light w-100 border rounded-3 p-3 text-center" style="background-color: #f8fafc;">
                                        <i class="fa fa-user fs-3 text-secondary mb-2"/>
                                        <div class="fs-3 fw-bold text-dark"><field name="count_ph_adult" readonly="1"/></div>
                                        <div class="text-muted fw-bold mt-1" style="font-size: 11px;">PH Насанд хүрэгч</div>
                                    </button>
                                </div>
                                <div class="col">
                                    <button type="object" name="action_open_ph_kids" class="btn btn-light w-100 border rounded-3 p-3 text-center" style="background-color: #f8fafc;">
                                        <i class="fa fa-child fs-3 text-secondary mb-2"/>
                                        <div class="fs-3 fw-bold text-dark"><field name="count_ph_kids" readonly="1"/></div>
                                        <div class="text-muted fw-bold mt-1" style="font-size: 11px;">PH Хүүхэд</div>
                                    </button>
                                </div>
                                <div class="col">
                                    <button type="object" name="action_open_jp_student" class="btn btn-light w-100 border rounded-3 p-3 text-center" style="background-color: #f8fafc;">
                                        <i class="fa fa-graduation-cap fs-3 text-secondary mb-2"/>
                                        <div class="fs-3 fw-bold text-dark"><field name="count_jp_student" readonly="1"/></div>
                                        <div class="text-muted fw-bold mt-1" style="font-size: 11px;">JP Оюутан</div>
                                    </button>
                                </div>
                                <div class="col">
                                    <button type="object" name="action_open_jp_worker" class="btn btn-light w-100 border rounded-3 p-3 text-center" style="background-color: #f8fafc;">
                                        <i class="fa fa-wrench fs-3 text-secondary mb-2"/>
                                        <div class="fs-3 fw-bold text-dark"><field name="count_jp_worker" readonly="1"/></div>
                                        <div class="text-muted fw-bold mt-1" style="font-size: 11px;">JP Ажилтан</div>
                                    </button>
                                </div>
                                <div class="col">
                                    <button type="object" name="action_open_kr" class="btn btn-light w-100 border rounded-3 p-3 text-center" style="background-color: #f8fafc;">
                                        <i class="fa fa-book fs-3 text-secondary mb-2"/>
                                        <div class="fs-3 fw-bold text-dark"><field name="count_kr" readonly="1"/></div>
                                        <div class="text-muted fw-bold mt-1" style="font-size: 11px;">Солонгос</div>
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- ROW 3: Finance & Analytics -->
                    <div class="row g-4">
                        <!-- Finance Summary -->
                        <div class="col-md-7" groups="mngglobal_visa.group_visa_finance,mngglobal_visa.group_visa_manager">
                            <div class="card border-0 shadow-sm rounded-4 h-100">
                                <div class="card-header bg-white border-bottom-0 pt-4 pb-2 px-4">
                                    <h5 class="fw-bold m-0" style="color: #1e293b;">
                                        <i class="fa fa-money text-success me-2"/> Санхүүгийн тойм
                                    </h5>
                                </div>
                                <div class="card-body p-4 d-flex flex-column justify-content-center gap-4">
                                    <!-- Total Fees -->
                                    <div class="d-flex justify-content-between align-items-center">
                                        <div>
                                            <div class="text-muted text-uppercase fw-bold mb-1" style="font-size: 11px; letter-spacing: 0.5px;">Нийт нэхэмжилсэн хураамж</div>
                                            <div class="fs-3 fw-bold" style="color: #0f172a;">
                                                <field name="total_fees" widget="monetary" options="{'currency_field': 'currency_id'}" readonly="1"/>
                                            </div>
                                        </div>
                                        <div class="rounded-3 d-flex align-items-center justify-content-center" style="width: 48px; height: 48px; background-color: #dbeafe; color: #2563eb;">
                                            <i class="fa fa-file-text-o fs-5"/>
                                        </div>
                                    </div>
                                    <!-- Collected -->
                                    <div class="d-flex justify-content-between align-items-center">
                                        <div>
                                            <div class="text-muted text-uppercase fw-bold mb-1" style="font-size: 11px; letter-spacing: 0.5px;">Бодитоор цугласан орлого</div>
                                            <div class="fs-3 fw-bold" style="color: #059669;">
                                                <field name="total_collected" widget="monetary" options="{'currency_field': 'currency_id'}" readonly="1"/>
                                            </div>
                                        </div>
                                        <div class="rounded-3 d-flex align-items-center justify-content-center" style="width: 48px; height: 48px; background-color: #d1fae5; color: #059669;">
                                            <i class="fa fa-check fs-5"/>
                                        </div>
                                    </div>
                                    <!-- Outstanding -->
                                    <div class="d-flex justify-content-between align-items-center">
                                        <div>
                                            <div class="text-muted text-uppercase fw-bold mb-1" style="font-size: 11px; letter-spacing: 0.5px;">Цуглуулах шаардлагатай авлага</div>
                                            <div class="fs-3 fw-bold" style="color: #e11d48;">
                                                <field name="total_outstanding" widget="monetary" options="{'currency_field': 'currency_id'}" readonly="1"/>
                                            </div>
                                        </div>
                                        <div class="rounded-3 d-flex align-items-center justify-content-center" style="width: 48px; height: 48px; background-color: #ffe4e6; color: #e11d48;">
                                            <i class="fa fa-calculator fs-5"/>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Strategic Analytics -->
                        <div class="col-md-5">
                            <div class="card border-0 shadow-sm rounded-4 h-100">
                                <div class="card-header bg-white border-bottom-0 pt-4 pb-2 px-4">
                                    <h5 class="fw-bold m-0" style="color: #1e293b;">
                                        <i class="fa fa-bar-chart text-purple me-2" style="color: #8b5cf6;"/> Стратеги шинжилгээ
                                    </h5>
                                </div>
                                <div class="card-body p-4 d-flex flex-column gap-3">
                                    <button type="action" name="%(mngglobal_visa.mng_visa_app_action_chart_program)d" 
                                            class="btn btn-light w-100 border text-start p-3 rounded-3 d-flex align-items-center" style="background-color: white;">
                                        <div class="rounded-3 d-flex align-items-center justify-content-center me-3" style="width: 40px; height: 40px; background-color: #e0e7ff; color: #4f46e5;">
                                            <i class="fa fa-pie-chart"/>
                                        </div>
                                        <span class="fw-bold text-dark">Хөтөлбөрийн нарийвчилсан тойм</span>
                                    </button>
                                    <button type="action" name="%(mngglobal_visa.mng_visa_app_action_chart_worker)d" 
                                            class="btn btn-light w-100 border text-start p-3 rounded-3 d-flex align-items-center" style="background-color: white;">
                                        <div class="rounded-3 d-flex align-items-center justify-content-center me-3" style="width: 40px; height: 40px; background-color: #d1fae5; color: #059669;">
                                            <i class="fa fa-users"/>
                                        </div>
                                        <span class="fw-bold text-dark">Ажилтны ачаалал, гүйцэтгэл</span>
                                    </button>
                                    <button type="action" name="%(mngglobal_visa.mng_visa_app_action_chart_stage)d" 
                                            class="btn btn-light w-100 border text-start p-3 rounded-3 d-flex align-items-center" style="background-color: white;">
                                        <div class="rounded-3 d-flex align-items-center justify-content-center me-3" style="width: 40px; height: 40px; background-color: #fef3c7; color: #d97706;">
                                            <i class="fa fa-tasks"/>
                                        </div>
                                        <span class="fw-bold text-dark">Үе шатны дамжлагын хяналт</span>
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>

                </sheet>
            </form>        </field>
    </record>

    <record id="mng_visa_dashboard_action" model="ir.actions.act_window">
        <field name="name">Удирдлагын самбар</field>
        <field name="res_model">mng.visa.dashboard</field>
        <field name="view_mode">form</field>
        <field name="target">main</field>
    </record>

</odoo>
