<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="mng_visa_dashboard_form" model="ir.ui.view">
        <field name="name">mng.visa.dashboard.form</field>
        <field name="model">mng.visa.dashboard</field>
        <field name="arch" type="xml">
            <form string="Удирдлагын самбар" create="0" edit="0" delete="0">
                <style>
                    /* Premium Silicon Valley Dashboard Overrides */
                    .o_form_view .o_form_sheet_bg { background: transparent !important; border: none !important; }
                    .o_form_view .o_form_sheet { max-width: 1400px !important; margin: 0 auto !important; padding: 0 !important; border: none !important; box-shadow: none !important;}
                    
                    .mng_card {
                        background: #ffffff;
                        border-radius: 20px;
                        border: 1px solid rgba(0,0,0,0.05);
                        box-shadow: 0 10px 15px -3px rgba(0,0,0,0.05), 0 4px 6px -2px rgba(0,0,0,0.025);
                        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
                        overflow: hidden;
                    }
                    .mng_card_hover { cursor: pointer; outline: none; display: block; width: 100%; text-align: left; padding: 1.5rem; }
                    .mng_card_hover:hover {
                        transform: translateY(-6px);
                        box-shadow: 0 20px 25px -5px rgba(0,0,0,0.1), 0 10px 10px -5px rgba(0,0,0,0.04);
                    }
                    
                    /* Deep Premium Gradients */
                    .mng_grad_primary { background: linear-gradient(135deg, #6366f1 0%, #4338ca 100%); }
                    .mng_grad_success { background: linear-gradient(135deg, #10b981 0%, #047857 100%); }
                    .mng_grad_danger  { background: linear-gradient(135deg, #f43f5e 0%, #be123c 100%); }
                    .mng_grad_warning { background: linear-gradient(135deg, #f59e0b 0%, #b45309 100%); }
                    
                    /* Forced Typography strictly overriding Odoo fields */
                    .mng_val_xl span, .mng_val_xl div, .mng_val_xl .o_field_widget {
                        font-size: 3rem !important;
                        font-weight: 800 !important;
                        letter-spacing: -1px !important;
                        line-height: 1 !important;
                        color: #ffffff !important;
                    }
                    .mng_val_lg span, .mng_val_lg div, .mng_val_lg .o_field_widget {
                        font-size: 2.25rem !important;
                        font-weight: 800 !important;
                        line-height: 1 !important;
                        color: #0f172a !important;
                    }
                    .mng_val_md span, .mng_val_md div, .mng_val_md .o_field_widget {
                        font-size: 1.5rem !important;
                        font-weight: 700 !important;
                        color: inherit !important;
                    }
                    /* Special colored monetary fields */
                    .mng_text_emerald span, .mng_text_emerald .o_field_widget { color: #059669 !important; }
                    .mng_text_rose span, .mng_text_rose .o_field_widget { color: #e11d48 !important; }
                    
                    .mng_subtext { font-size: 0.85rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; opacity: 0.8; }
                    .text-white-80 { color: rgba(255,255,255,0.8); }
                    
                    .mng_icon_box { width: 64px; height: 64px; border-radius: 16px; display: flex; align-items: center; justify-content: center; font-size: 2rem; }
                    .mng_icon_box.glass { background: rgba(255,255,255,0.2); color: #ffffff; border: 1px solid rgba(255,255,255,0.3); }
                    
                    .mng_btn_list { display: flex; align-items: center; padding: 1.25rem 1.5rem; border-radius: 14px; background: #f8fafc; border: 1px solid transparent; transition: all 0.2s; outline: none; width: 100%; text-align: left; }
                    .mng_btn_list:hover { background: #ffffff; border-color: #cbd5e1; transform: translateX(8px); box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05); }
                    .mng_btn_icon { width: 48px; height: 48px; border-radius: 12px; display: flex; align-items: center; justify-content: center; font-size: 1.5rem; margin-right: 1.25rem; }
                    
                    .bg-indigo-subtle { background: #e0e7ff; color: #4f46e5; }
                    .bg-emerald-subtle { background: #d1fae5; color: #059669; }
                    .bg-amber-subtle { background: #fef3c7; color: #d97706; }
                </style>
                <field name="currency_id" invisible="1"/>
                <sheet>
                    
                    <!-- Title -->
                    <div class="d-flex justify-content-between align-items-center mb-4 pb-3" style="border-bottom: 2px solid #f1f5f9;">
                        <h2 class="fw-bold m-0" style="color: #0f172a; font-size: 2rem; letter-spacing: -0.5px;">
                            MNG Global <span style="color: #6366f1;">•</span> Удирдлагын самбар
                        </h2>
                    </div>

                    <!-- ROW 1: Hero KPIs -->
                    <div class="row g-4 mb-5">
                        <div class="col-xl-3 col-md-6">
                            <button type="object" name="action_open_applications" class="mng_card mng_card_hover mng_grad_primary border-0">
                                <div class="d-flex justify-content-between align-items-start">
                                    <div>
                                        <div class="mng_subtext text-white-80 mb-2">Идэвхтэй гэрээ</div>
                                        <div class="mng_val_xl"><field name="total_active" readonly="1"/></div>
                                    </div>
                                    <div class="mng_icon_box glass"><i class="fa fa-briefcase"/></div>
                                </div>
                            </button>
                        </div>

                        <div class="col-xl-3 col-md-6">
                            <button type="object" name="action_open_departures" class="mng_card mng_card_hover mng_grad_success border-0">
                                <div class="d-flex justify-content-between align-items-start">
                                    <div>
                                        <div class="mng_subtext text-white-80 mb-2">Ойрын нисэлтүүд</div>
                                        <div class="mng_val_xl"><field name="departures_next_30" readonly="1"/></div>
                                    </div>
                                    <div class="mng_icon_box glass"><i class="fa fa-plane"/></div>
                                </div>
                            </button>
                        </div>

                        <div class="col-xl-3 col-md-6" groups="mngglobal_visa.group_visa_finance,mngglobal_visa.group_visa_manager">
                            <button type="object" name="action_open_overdue" class="mng_card mng_card_hover mng_grad_danger border-0">
                                <div class="d-flex justify-content-between align-items-start">
                                    <div>
                                        <div class="mng_subtext text-white-80 mb-2">Төлбөр хэтэрсэн</div>
                                        <div class="mng_val_xl"><field name="overdue_payments" readonly="1"/></div>
                                    </div>
                                    <div class="mng_icon_box glass"><i class="fa fa-exclamation-triangle"/></div>
                                </div>
                            </button>
                        </div>

                        <div class="col-xl-3 col-md-6">
                            <button type="object" name="action_open_insurance" class="mng_card mng_card_hover mng_grad_warning border-0">
                                <div class="d-flex justify-content-between align-items-start">
                                    <div>
                                        <div class="mng_subtext text-white-80 mb-2">Даатгал дуусах</div>
                                        <div class="mng_val_xl"><field name="insurance_due_soon" readonly="1"/></div>
                                    </div>
                                    <div class="mng_icon_box glass"><i class="fa fa-shield"/></div>
                                </div>
                            </button>
                        </div>
                    </div>

                    <!-- ROW 2: Program Distribution -->
                    <div class="mng_card mb-5">
                        <div class="px-4 pt-4 pb-0">
                            <h5 class="fw-bold m-0" style="color: #1e293b; font-size: 1.25rem;">
                                <i class="fa fa-globe text-primary me-2"/> Хөтөлбөрийн хуваарилалт
                            </h5>
                        </div>
                        <div class="p-4">
                            <div class="row g-3">
                                <div class="col">
                                    <button type="object" name="action_open_ph_adult" class="mng_card_hover rounded-4 text-center border" style="background:#f8fafc; padding:1.5rem;">
                                        <i class="fa fa-user mb-3" style="font-size:2rem; color:#94a3b8;"/>
                                        <div class="mng_val_lg"><field name="count_ph_adult" readonly="1"/></div>
                                        <div class="mng_subtext text-secondary mt-2">PH Насанд хүрэгч</div>
                                    </button>
                                </div>
                                <div class="col">
                                    <button type="object" name="action_open_ph_kids" class="mng_card_hover rounded-4 text-center border" style="background:#f8fafc; padding:1.5rem;">
                                        <i class="fa fa-child mb-3" style="font-size:2rem; color:#94a3b8;"/>
                                        <div class="mng_val_lg"><field name="count_ph_kids" readonly="1"/></div>
                                        <div class="mng_subtext text-secondary mt-2">PH Хүүхэд</div>
                                    </button>
                                </div>
                                <div class="col">
                                    <button type="object" name="action_open_jp_student" class="mng_card_hover rounded-4 text-center border" style="background:#f8fafc; padding:1.5rem;">
                                        <i class="fa fa-graduation-cap mb-3" style="font-size:2rem; color:#94a3b8;"/>
                                        <div class="mng_val_lg"><field name="count_jp_student" readonly="1"/></div>
                                        <div class="mng_subtext text-secondary mt-2">JP Оюутан</div>
                                    </button>
                                </div>
                                <div class="col">
                                    <button type="object" name="action_open_jp_worker" class="mng_card_hover rounded-4 text-center border" style="background:#f8fafc; padding:1.5rem;">
                                        <i class="fa fa-wrench mb-3" style="font-size:2rem; color:#94a3b8;"/>
                                        <div class="mng_val_lg"><field name="count_jp_worker" readonly="1"/></div>
                                        <div class="mng_subtext text-secondary mt-2">JP Ажилтан</div>
                                    </button>
                                </div>
                                <div class="col">
                                    <button type="object" name="action_open_kr" class="mng_card_hover rounded-4 text-center border" style="background:#f8fafc; padding:1.5rem;">
                                        <i class="fa fa-book mb-3" style="font-size:2rem; color:#94a3b8;"/>
                                        <div class="mng_val_lg"><field name="count_kr" readonly="1"/></div>
                                        <div class="mng_subtext text-secondary mt-2">Солонгос</div>
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- ROW 3: Finance & Analytics -->
                    <div class="row g-4">
                        <!-- Finance Component -->
                        <div class="col-xl-7" groups="mngglobal_visa.group_visa_finance,mngglobal_visa.group_visa_manager">
                            <div class="mng_card h-100">
                                <div class="px-4 pt-4 pb-2 border-bottom" style="border-color:#f1f5f9 !important;">
                                    <h5 class="fw-bold m-0" style="color: #1e293b; font-size: 1.25rem;">
                                        <i class="fa fa-money text-success me-2"/> Санхүүгийн тойм
                                    </h5>
                                </div>
                                <div class="p-4 d-flex flex-column justify-content-center gap-4 h-100">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <div>
                                            <div class="mng_subtext text-secondary mb-1">Нийт нэхэмжилсэн хураамж</div>
                                            <div class="mng_val_lg" style="color:#0f172a;"><field name="total_fees" widget="monetary" options="{'currency_field': 'currency_id'}" readonly="1"/></div>
                                        </div>
                                        <div class="mng_icon_box bg-indigo-subtle"><i class="fa fa-file-text-o"/></div>
                                    </div>
                                    <div class="d-flex justify-content-between align-items-center">
                                        <div>
                                            <div class="mng_subtext text-secondary mb-1">Бодитоор цугласан орлого</div>
                                            <div class="mng_val_lg mng_text_emerald"><field name="total_collected" widget="monetary" options="{'currency_field': 'currency_id'}" readonly="1"/></div>
                                        </div>
                                        <div class="mng_icon_box bg-emerald-subtle"><i class="fa fa-check"/></div>
                                    </div>
                                    <div class="d-flex justify-content-between align-items-center">
                                        <div>
                                            <div class="mng_subtext text-secondary mb-1">Цуглуулах шаардлагатай авлага</div>
                                            <div class="mng_val_lg mng_text_rose"><field name="total_outstanding" widget="monetary" options="{'currency_field': 'currency_id'}" readonly="1"/></div>
                                        </div>
                                        <div class="mng_icon_box" style="background:#ffe4e6; color:#e11d48;"><i class="fa fa-calculator"/></div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Analytics Component -->
                        <div class="col-xl-5">
                            <div class="mng_card h-100">
                                <div class="px-4 pt-4 pb-2 border-bottom" style="border-color:#f1f5f9 !important;">
                                    <h5 class="fw-bold m-0" style="color: #1e293b; font-size: 1.25rem;">
                                        <i class="fa fa-bar-chart me-2" style="color:#8b5cf6;"/> Стратеги шинжилгээ
                                    </h5>
                                </div>
                                <div class="p-4 d-flex flex-column gap-3">
                                    <button type="action" name="%(mngglobal_visa.mng_visa_app_action_chart_program)d" class="mng_btn_list">
                                        <div class="mng_btn_icon bg-indigo-subtle"><i class="fa fa-pie-chart"/></div>
                                        <span class="fs-5 fw-bold" style="color:#1e293b;">Хөтөлбөрийн нарийвчилсан тойм</span>
                                    </button>
                                    <button type="action" name="%(mngglobal_visa.mng_visa_app_action_chart_worker)d" class="mng_btn_list">
                                        <div class="mng_btn_icon bg-emerald-subtle"><i class="fa fa-users"/></div>
                                        <span class="fs-5 fw-bold" style="color:#1e293b;">Ажилтны ачаалал, гүйцэтгэл</span>
                                    </button>
                                    <button type="action" name="%(mngglobal_visa.mng_visa_app_action_chart_stage)d" class="mng_btn_list">
                                        <div class="mng_btn_icon bg-amber-subtle"><i class="fa fa-tasks"/></div>
                                        <span class="fs-5 fw-bold" style="color:#1e293b;">Үе шатны дамжлагын хяналт</span>
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>

                </sheet>
            </form>        </field>
    </record>

    <record id="mng_visa_dashboard_action" model="ir.actions.act_window">
        <field name="name">Удирдлагын самбар</field>
        <field name="res_model">mng.visa.dashboard</field>
        <field name="view_mode">form</field>
        <field name="target">main</field>
    </record>

</odoo>
