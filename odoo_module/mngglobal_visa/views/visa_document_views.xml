<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Document Form View -->
    <record id="mng_visa_document_form" model="ir.ui.view">
        <field name="name">mng.visa.document.form</field>
        <field name="model">mng.visa.document</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_preview"
                            string="👁 Урьдчилан харах"
                            type="object" class="oe_highlight"
                            invisible="not file"/>
                    <button name="action_download"
                            string="⬇ Татах"
                            type="object"
                            invisible="not file"/>
                </header>
                <sheet>
                    <group>
                        <group string="Баримтын мэдээлэл">
                            <field name="name"/>
                            <field name="document_type"/>
                            <field name="application_id"/>
                            <field name="upload_date"/>
                            <field name="uploaded_by"/>
                        </group>
                        <group string="Файл">
                            <field name="file" filename="file_name"/>
                            <field name="file_name" invisible="1"/>
                            <field name="notes"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Document List View (active documents) -->
    <record id="mng_visa_document_list" model="ir.ui.view">
        <field name="name">mng.visa.document.list</field>
        <field name="model">mng.visa.document</field>
        <field name="arch" type="xml">
            <list delete="0">
                <field name="sequence" widget="handle"/>
                <field name="document_type"/>
                <field name="name"/>
                <field name="file_name"/>
                <field name="upload_date"/>
                <field name="uploaded_by"/>
                <button name="action_preview" type="object"
                        string="👁" title="Урьдчилан харах"
                        class="btn-link"/>
                <button name="action_download" type="object"
                        string="⬇" title="Татах"
                        class="btn-link"/>
                <button name="action_delete_document" type="object"
                        icon="fa-trash" title="Устгах"
                        confirm="Энэ баримтыг устгахдаа итгэлтэй байна уу? Баримт 7 хоногийн турш сэргээх боломжтой хогийн сагсанд хадгалагдана."
                        class="btn-link text-danger"/>
            </list>
        </field>
    </record>

    <!-- Document Trash List View (soft-deleted documents) -->
    <record id="mng_visa_document_trash_list" model="ir.ui.view">
        <field name="name">mng.visa.document.trash.list</field>
        <field name="model">mng.visa.document</field>
        <field name="arch" type="xml">
            <list delete="0" create="0" edit="0"
                  decoration-muted="1 == 1">
                <field name="document_type"/>
                <field name="name"/>
                <field name="file_name"/>
                <field name="application_id" string="Гэрээ"/>
                <field name="deleted_at" string="Устгасан огноо"/>
                <field name="deleted_by" string="Устгасан хэрэглэгч"/>
                <button name="action_restore_document" type="object"
                        string="Сэргээх" icon="fa-undo"
                        title="Сэргээх"
                        class="btn-link text-success"/>
            </list>
        </field>
    </record>

    <!-- Trash standalone action -->
    <record id="mng_visa_document_trash_action" model="ir.actions.act_window">
        <field name="name">Устгасан баримтууд (Хогийн сагс)</field>
        <field name="res_model">mng.visa.document</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="mng_visa_document_trash_list"/>
        <field name="domain">[("active", "=", False)]</field>
        <field name="context">{"active_test": False}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Устгасан баримт байхгүй байна.
            </p>
            <p>7 хоног өнгөрсний дараа баримтууд автоматаар бүрмөсөн устгагдана.</p>
        </field>
    </record>

</odoo>
