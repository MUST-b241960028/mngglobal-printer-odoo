<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <menuitem id="mng_visa_root_menu"
              name="MNG Виза"
              web_icon="mngglobal_visa,static/description/icon.png"
              sequence="5"/>

    <menuitem id="mng_visa_dashboard_menu"
              name="Dashboard"
              action="mng_visa_dashboard_action"
              parent="mng_visa_root_menu"
              sequence="1"
              groups="mngglobal_visa.group_visa_manager,base.group_system"/>

    <menuitem id="mng_visa_intake_menu"
              name="Шинэ хүсэлтүүд"
              action="mng_visa_cohort_workspace_intake"
              parent="mng_visa_root_menu"
              sequence="5"/>

    <!-- Program categories — flat top-level for fast 1-click access -->
    <menuitem id="mng_visa_ph_adult_menu"
              name="Филиппин Насанд хүрэгч"
              action="mng_visa_cohort_workspace_ph_adult"
              parent="mng_visa_root_menu"
              sequence="10"
              groups="mngglobal_visa.group_visa_ph_adult,mngglobal_visa.group_visa_manager"/>

    <menuitem id="mng_visa_ph_kids_menu"
              name="Филиппин Хүүхэд"
              action="mng_visa_cohort_workspace_ph_kids"
              parent="mng_visa_root_menu"
              sequence="20"
              groups="mngglobal_visa.group_visa_ph_kids,mngglobal_visa.group_visa_manager"/>

    <menuitem id="mng_visa_jp_student_menu"
              name="Япон Оюутан"
              action="mng_visa_cohort_workspace_jp_student"
              parent="mng_visa_root_menu"
              sequence="30"
              groups="mngglobal_visa.group_visa_jp_student,mngglobal_visa.group_visa_manager"/>

    <menuitem id="mng_visa_jp_worker_menu"
              name="Япон Ажилтан"
              action="mng_visa_cohort_workspace_jp_worker"
              parent="mng_visa_root_menu"
              sequence="40"
              groups="mngglobal_visa.group_visa_jp_worker,mngglobal_visa.group_visa_manager"/>

    <menuitem id="mng_visa_kr_menu"
              name="Солонгос"
              action="mng_visa_cohort_workspace_kr"
              parent="mng_visa_root_menu"
              sequence="50"
              groups="mngglobal_visa.group_visa_kr,mngglobal_visa.group_visa_manager"/>

    <!-- Finance -->
    <menuitem id="mng_visa_finance_menu"
              name="Санхүү"
              parent="mng_visa_root_menu"
              sequence="60"
              groups="mngglobal_visa.group_visa_finance,mngglobal_visa.group_visa_manager"/>

    <menuitem id="mng_visa_finance_apps_menu"
              name="Төлбөрийн тоймлол"
              action="mng_visa_app_action_finance"
              parent="mng_visa_finance_menu"
              sequence="10"
              groups="mngglobal_visa.group_visa_finance,mngglobal_visa.group_visa_manager"/>

    <!-- Reports -->
    <menuitem id="mng_visa_reports_menu"
              name="Тайлан"
              parent="mng_visa_root_menu"
              sequence="70"
              groups="mngglobal_visa.group_visa_manager,base.group_system"/>

    <menuitem id="mng_visa_report_program_menu"
              name="Хөтөлбөрийн тойм"
              action="mng_visa_app_action_chart_program"
              parent="mng_visa_reports_menu"
              sequence="10"/>

    <menuitem id="mng_visa_report_worker_menu"
              name="Ажилтны ачаалал"
              action="mng_visa_app_action_chart_worker"
              parent="mng_visa_reports_menu"
              sequence="20"/>

    <menuitem id="mng_visa_report_stage_menu"
              name="Үе шатны тойм"
              action="mng_visa_app_action_chart_stage"
              parent="mng_visa_reports_menu"
              sequence="30"/>

    <menuitem id="mng_visa_audit_menu"
              name="Үйл ажиллагааны түүх"
              action="mng_visa_audit_action"
              parent="mng_visa_reports_menu"
              sequence="40"
              groups="mngglobal_visa.group_visa_manager,base.group_system"/>

    <!-- Restrict standard Odoo Accounting/Invoicing app to finance group only -->
    <record id="account.menu_finance" model="ir.ui.menu">
        <field name="group_ids" eval="[(6, 0, [
            ref('mngglobal_visa.group_visa_finance'),
            ref('base.group_system'),
        ])]"/>
    </record>

    <!-- Settings -->
    <menuitem id="mng_visa_config_menu"
              name="Тохиргоо"
              parent="mng_visa_root_menu"
              sequence="100"/>

    <!-- AI Assistant Menu -->
    <menuitem id="mng_visa_ai_copilot_menu"
              name="AI Туслах"
              action="mng_visa_ai_copilot_wizard_action"
              parent="mng_visa_root_menu"
              sequence="2"/>

    <menuitem id="mng_visa_checklist_tmpl_menu"
              name="Шалгах хуудасны загвар"
              action="mng_visa_checklist_tmpl_action"
              parent="mng_visa_config_menu"
              sequence="10"/>

    <menuitem id="mng_visa_recruitment_period_config_menu"
              name="Элсэлтийн үе тохиргоо"
              action="mng_visa_recruitment_period_action"
              parent="mng_visa_config_menu"
              sequence="15"/>

    <menuitem id="mng_visa_fee_tmpl_menu"
              name="Төлбөрийн загвар"
              action="mng_visa_fee_tmpl_action"
              parent="mng_visa_config_menu"
              sequence="20"
              groups="mngglobal_visa.group_visa_finance,mngglobal_visa.group_visa_manager"/>

    <menuitem id="mng_visa_ai_config_menu"
              name="AI Тохиргоо"
              action="mng_visa_config_settings_action"
              parent="mng_visa_config_menu"
              sequence="30"
              groups="mngglobal_visa.group_visa_manager,base.group_system"/>

</odoo>
