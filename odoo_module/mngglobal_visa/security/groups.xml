<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Category -->
    <record id="module_category_mng_visa" model="ir.module.category">
        <field name="name">MNG Виза</field>
        <field name="description">Visa application management groups</field>
        <field name="sequence">10</field>
    </record>

    <!-- Base User Group (Hidden/Background) -->
    <record id="group_visa_user" model="res.groups">
        <field name="name">Хэрэглэгч (Суурь)</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <!-- Individual Program Privileges -->
    <record id="privilege_ph_adult" model="res.groups.privilege">
        <field name="name">Филиппин (Насанд хүрэгч)</field>
        <field name="category_id" ref="module_category_mng_visa"/>
        <field name="sequence">10</field>
    </record>
    <record id="group_visa_ph_adult" model="res.groups">
        <field name="name">Зөвшөөрөх</field>
        <field name="privilege_id" ref="privilege_ph_adult"/>
        <field name="implied_ids" eval="[(4, ref('group_visa_user'))]"/>
    </record>

    <record id="privilege_ph_kids" model="res.groups.privilege">
        <field name="name">Филиппин (Хүүхэд)</field>
        <field name="category_id" ref="module_category_mng_visa"/>
        <field name="sequence">11</field>
    </record>
    <record id="group_visa_ph_kids" model="res.groups">
        <field name="name">Зөвшөөрөх</field>
        <field name="privilege_id" ref="privilege_ph_kids"/>
        <field name="implied_ids" eval="[(4, ref('group_visa_user'))]"/>
    </record>

    <record id="privilege_jp_student" model="res.groups.privilege">
        <field name="name">Япон (Оюутан)</field>
        <field name="category_id" ref="module_category_mng_visa"/>
        <field name="sequence">12</field>
    </record>
    <record id="group_visa_jp_student" model="res.groups">
        <field name="name">Зөвшөөрөх</field>
        <field name="privilege_id" ref="privilege_jp_student"/>
        <field name="implied_ids" eval="[(4, ref('group_visa_user'))]"/>
    </record>

    <record id="privilege_jp_worker" model="res.groups.privilege">
        <field name="name">Япон (Ажилтан)</field>
        <field name="category_id" ref="module_category_mng_visa"/>
        <field name="sequence">13</field>
    </record>
    <record id="group_visa_jp_worker" model="res.groups">
        <field name="name">Зөвшөөрөх</field>
        <field name="privilege_id" ref="privilege_jp_worker"/>
        <field name="implied_ids" eval="[(4, ref('group_visa_user'))]"/>
    </record>

    <record id="privilege_kr" model="res.groups.privilege">
        <field name="name">Солонгос</field>
        <field name="category_id" ref="module_category_mng_visa"/>
        <field name="sequence">14</field>
    </record>
    <record id="group_visa_kr" model="res.groups">
        <field name="name">Зөвшөөрөх</field>
        <field name="privilege_id" ref="privilege_kr"/>
        <field name="implied_ids" eval="[(4, ref('group_visa_user'))]"/>
    </record>

    <!-- Global/Admin Roles -->
    <record id="privilege_visa_finance" model="res.groups.privilege">
        <field name="name">Санхүүгийн удирдлага</field>
        <field name="category_id" ref="module_category_mng_visa"/>
        <field name="sequence">20</field>
    </record>
    <record id="group_visa_finance" model="res.groups">
        <field name="name">Зөвшөөрөх</field>
