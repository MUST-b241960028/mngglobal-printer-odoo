    </record>

    <record id="privilege_visa_manager" model="res.groups.privilege">
        <field name="name">Бүх хөтөлбөрийн менежер</field>
        <field name="category_id" ref="module_category_mng_visa"/>
        <field name="sequence">30</field>
    </record>
    <record id="group_visa_manager" model="res.groups">
        <field name="name">Тийм</field>
        <field name="privilege_id" ref="privilege_visa_manager"/>
        <field name="implied_ids" eval="[(4, ref('group_visa_user'))]"/>
    </record>

</odoo>
