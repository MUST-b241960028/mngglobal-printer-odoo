<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_mng_visa" model="ir.module.category">
        <field name="name">MNG Виза</field>
        <field name="description">Visa application access per program</field>
        <field name="sequence">10</field>
    </record>

    <record id="group_visa_user" model="res.groups">
        <field name="name">Суурь хандалт (User)</field>
        <field name="category_id" ref="module_category_mng_visa"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <!-- Program Groups - No Category assigned so they appear as standalone Checkboxes in Odoo UI -->
    <record id="group_visa_ph_adult" model="res.groups">
        <field name="name">Хөтөлбөр: Филиппин (Насанд хүрэгч)</field>
        <field name="implied_ids" eval="[(4, ref('group_visa_user'))]"/>
    </record>

    <record id="group_visa_ph_kids" model="res.groups">
        <field name="name">Хөтөлбөр: Филиппин (Хүүхэд)</field>
        <field name="implied_ids" eval="[(4, ref('group_visa_user'))]"/>
    </record>

    <record id="group_visa_jp_student" model="res.groups">
        <field name="name">Хөтөлбөр: Япон (Оюутан)</field>
        <field name="implied_ids" eval="[(4, ref('group_visa_user'))]"/>
    </record>

    <record id="group_visa_jp_worker" model="res.groups">
        <field name="name">Хөтөлбөр: Япон (Ажилтан)</field>
        <field name="implied_ids" eval="[(4, ref('group_visa_user'))]"/>
    </record>

    <record id="group_visa_kr" model="res.groups">
        <field name="name">Хөтөлбөр: Солонгос</field>
        <field name="implied_ids" eval="[(4, ref('group_visa_user'))]"/>
    </record>

    <!-- Finance & Admin Roles -->
    <record id="group_visa_finance" model="res.groups">
        <field name="name">Санхүүгийн эрх</field>
        <field name="category_id" ref="module_category_mng_visa"/>
        <field name="implied_ids" eval="[(4, ref('group_visa_user'))]"/>
    </record>

    <record id="group_visa_manager" model="res.groups">
        <field name="name">Менежер (Бүх эрх)</field>
        <field name="category_id" ref="module_category_mng_visa"/>
        <field name="implied_ids" eval="[
            (4, ref('group_visa_user')),
            (4, ref('group_visa_ph_adult')),
            (4, ref('group_visa_ph_kids')),
            (4, ref('group_visa_jp_student')),
            (4, ref('group_visa_jp_worker')),
            (4, ref('group_visa_kr')),
            (4, ref('group_visa_finance'))
        ]"/>
    </record>
</odoo>
