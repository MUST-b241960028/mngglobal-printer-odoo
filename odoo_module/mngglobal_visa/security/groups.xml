<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Base category container -->
    <record id="module_category_mng_visa_main" model="ir.module.category">
        <field name="name">MNG Виза (Үндсэн эрх)</field>
        <field name="sequence">10</field>
    </record>

    <record id="module_category_mng_visa_programs" model="ir.module.category">
        <field name="name">MNG Виза (Хөтөлбөрийн эрх)</field>
        <field name="description">Checkboxes for specific program access.</field>
        <field name="sequence">11</field>
    </record>

    <record id="group_visa_user" model="res.groups">
        <field name="name">Суурь хандалт (User)</field>
        <field name="category_id" ref="module_category_mng_visa_main"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <!-- Program checkboxes - by assigning them all to a category, they might become booleans if we don't chain them. 
         Wait! To strictly force checkboxes, they just shouldn't imply each other. 
         Wait, Odoo renders groups in the same category as a radio ONLY IF they have the same category AND are not separated. 
         Actually, the easiest way is to let Odoo render them as checkboxes by placing them in an explicitly named Category! -->

    <record id="group_visa_ph_adult" model="res.groups">
        <field name="name">Филиппин (Насанд хүрэгч)</field>
        <field name="category_id" ref="module_category_mng_visa_programs"/>
        <field name="implied_ids" eval="[(4, ref('group_visa_user'))]"/>
    </record>

    <record id="group_visa_ph_kids" model="res.groups">
        <field name="name">Филиппин (Хүүхэд)</field>
        <field name="category_id" ref="module_category_mng_visa_programs"/>
        <field name="implied_ids" eval="[(4, ref('group_visa_user'))]"/>
    </record>

    <record id="group_visa_jp_student" model="res.groups">
        <field name="name">Япон (Оюутан)</field>
        <field name="category_id" ref="module_category_mng_visa_programs"/>
        <field name="implied_ids" eval="[(4, ref('group_visa_user'))]"/>
    </record>

    <record id="group_visa_jp_worker" model="res.groups">
        <field name="name">Япон (Ажилтан)</field>
        <field name="category_id" ref="module_category_mng_visa_programs"/>
        <field name="implied_ids" eval="[(4, ref('group_visa_user'))]"/>
    </record>

    <record id="group_visa_kr" model="res.groups">
        <field name="name">Солонгос</field>
        <field name="category_id" ref="module_category_mng_visa_programs"/>
        <field name="implied_ids" eval="[(4, ref('group_visa_user'))]"/>
    </record>

    <!-- Admin/Finance Roles -->
    <record id="group_visa_finance" model="res.groups">
        <field name="name">Санхүүгийн эрх</field>
        <field name="category_id" ref="module_category_mng_visa_main"/>
        <field name="implied_ids" eval="[(4, ref('group_visa_user'))]"/>
    </record>

    <record id="group_visa_manager" model="res.groups">
        <field name="name">Менежер (Бүх эрх)</field>
        <field name="category_id" ref="module_category_mng_visa_main"/>
        <field name="implied_ids" eval="[
            (4, ref('group_visa_user')),
            (4, ref('group_visa_ph_adult')),
            (4, ref('group_visa_ph_kids')),
            (4, ref('group_visa_jp_student')),
            (4, ref('group_visa_jp_worker')),
            (4, ref('group_visa_kr'))
        ]"/>
    </record>
</odoo>
